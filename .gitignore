# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pattern-referansefiler (lokale oppslagsverk og testutdata)
Pattern/*.pdf
Pattern/*.svg
.claude/

# Kvitteringsbilder brukt som testsett (inneholder kjøpsdetaljer)
docs/kvitteringer-test/

# Referansemateriale — hører hjemme i Drive, ikke i git
design/
Floral Font.zip

# Lokale strikkeoppskrifter (PDF-er) — skal aldri i git
strikk/Strikkeoppskrifter/
strikk/Strikkeoppskrifter ryddet/

# Lokal innlesing av strikkeoppskrifter (tekst og sidebilder fra PDF-ene)
strikk/innlesing/

# Lokal oppbygging av garnkatalogen (kandidater, runder og svar)
strikk/garn/

# Bilder av garnbanderoler, til registrering i garnlageret
strikk/Banderoler/
strikk/garnbilder/

# Lokal oppbygging av garnlager-gjennomgangen (konverterte bilder og funn per runde)
strikk/garnlager-arbeid/

# Innskannede strikkeoppskrifter under utskrift til PDF (kildebilder + arbeidsfiler)
oppskrifter/
